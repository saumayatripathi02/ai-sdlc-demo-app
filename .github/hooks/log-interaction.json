{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node scripts/log-interaction.js",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node scripts/log-interaction.js",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "node scripts/log-interaction.js",
        "timeoutSec": 10
      }
    ],
    "sessionStart": [
      {
        "type": "command",
        "command": "node scripts/log-interaction.js",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "command": "node scripts/log-interaction.js",
        "timeoutSec": 10
      }
    ]
  }
}
